# Copy to .env and fill in. NEVER commit the real .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Models (override if you like)
GEN_MODEL=claude-sonnet-4-6
GRADE_MODEL=claude-haiku-4-5

# CORS: comma-separated origins allowed to call this API.
# Use your real frontend origin in production instead of "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Caching (seconds). Set to 0 to disable.
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# Rate limits (requests per window, per client IP)
RATE_WINDOW_SECONDS=60
GENERATE_RATE_LIMIT=30
GRADE_RATE_LIMIT=60

# Safety: run an extra LLM safety check on the topic before generating.
# Costs one small call per new topic; recommended for a real kids' product.
LLM_TOPIC_MODERATION=false
